# ============================================================================
# Chatty — configuration (copy to .env and edit)
#
# Environment variables are the primary source of deployment configuration.
# The web Settings UI only exposes a validated subset (generation params);
# infrastructure settings (DB, Mimir endpoint) stay here.
# ============================================================================

# ---- App ------------------------------------------------------------------
APP_ENV=production
APP_PORT=3333
LOG_LEVEL=info

# ---- Database (the `chatty-db` container) ---------------------------------
DATABASE_HOST=chatty-db
DATABASE_PORT=5432
DATABASE_NAME=chatty
DATABASE_USER=chatty
DATABASE_SSLMODE=disable

# Single source of truth for the DB password. Compose feeds both Postgres
# (POSTGRES_PASSWORD) and the app (DATABASE_PASSWORD) from this value.
CHATTY_DB_PASSWORD=replace-with-a-long-random-secret

# ---- Mimir (existing inference service — DO NOT redeploy) -----------------
# Reachable over the shared `mimir_mimir` Docker network via the `inference` alias.
MIMIR_BASE_URL=http://inference:8080/v1
# Leave empty (or "auto") to auto-discover the model id from GET /v1/models.
MIMIR_MODEL=
MIMIR_API_KEY=
MIMIR_TIMEOUT=300
MIMIR_STREAM=true
MIMIR_THINKING=false
# auto | llamacpp | openai — controls request-compatibility (thinking control).
MIMIR_BACKEND=auto

# ---- Chat / generation defaults ------------------------------------------
CHAT_TEMPERATURE=0.7
# Deployed Qwen3-1.7B has a 2048-token context window; keep output modest.
CHAT_MAX_TOKENS=1024
CHAT_MAX_CONTEXT_MESSAGES=40
CHAT_MAX_CONTEXT_TOKENS=1400
